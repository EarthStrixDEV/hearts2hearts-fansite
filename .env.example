# Pulled by `neon deploy` / `neon env pull` into .env.local
DATABASE_URL=                # pooled (app traffic)
DATABASE_URL_UNPOOLED=       # direct (migrations)
DATABASE_URL_APP=            # pooled, role fan_app (non-owner, so RLS applies): create it with SQL, not the console (see db/migrations/0010_fan.sql)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=           # Neon Object Storage (S3)
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# app config (not injected by Neon)
NEON_AUTH_COOKIE_SECRET=     # openssl rand -base64 32
CRON_SECRET=
LLM_API_KEY=                 # notice reader (vision) + AI blog; server only
LLM_MODEL=
# tests only (never point these at production): a Neon BRANCH with the migrations applied
FAN_TEST_OWNER_URL=          # owner, direct connection of that branch
FAN_TEST_APP_URL=            # role fan_app of the same branch
E2E_BASE_URL=                # Playwright smoke tests, e.g. http://localhost:3130 (a dev server started against that branch)
